# Required: compose refuses to start without it, so this file (or the
# variable in your shell) must exist. The service always binds to 127.0.0.1.
DSH_HOST_PORT=3080

# Optional comma-separated browser authorities accepted by the /api trust
# fence (passed to dsh as --trusted-host). Use bare host or host:port values
# without schemes, paths, or wildcards. Leave empty for loopback-only use.
DSH_TRUSTED_HOSTS=

# Host directory exposed to the agent as /home/node/workspaces.
DSH_WORKSPACES=./workspaces

# Container user identity. On Linux, pass the output of `id -u` and `id -g`
# through the shell or set the values here. Docker Desktop can use the defaults.
DSH_UID=1000
DSH_GID=1000

# Keep a full Python toolchain (python3, pip, venv, plus python/pip aliases)
# in the image so agents can run Python in the workspaces. 1 keeps it, 0
# strips it out.
DSH_WITH_PYTHON=1

# Harness policy. Supported tool modes: native, ptc, both.
DSH_PERMISSION_MODE=workspace-write
DSH_TOOLS_MODE=native
DSH_TELEMETRY_DISABLED=1

# Optional. Leave unset to configure the provider in the Web UI.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
